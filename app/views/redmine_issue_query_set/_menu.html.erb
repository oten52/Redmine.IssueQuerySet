<% ids = @issue_ids.presence || (@issues && @issues.map(&:id)) %>
<% if ids.present? && User.current.logged? %>
  <% label = l(:redmine_issue_query_set_menu) %>
  <% label = sprite_icon('add', label) if respond_to?(:sprite_icon) %>
  <li><%= link_to label, '#',
        :class => 'icon icon-add issue-query-set-open',
        :data => {
          :issue_ids => ids.join(','),
          :project_id => (@project && @project.id)
        } %></li>
<% end %>
